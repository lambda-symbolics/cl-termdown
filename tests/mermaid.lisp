(in-package #:termdown/tests)

(defun mermaid-test-text (rows)
  "Flatten rendered rows for semantic content assertions."
  (with-output-to-string (stream)
    (dolist (row rows) (write-string (markdown-tests--row-text row) stream))))

(defun test-markdown-mermaid ()
  (let ((renderer (markdown-renderer-create :width 50)))
    (test-assert (null (markdown-render-line renderer "```mermaid")) "mermaid opener is buffered")
    (test-assert (null (markdown-render-line renderer "flowchart LR")) "mermaid body is buffered")
    (test-assert (null (markdown-render-line renderer "  A-->B")) "mermaid second body is buffered")
    (let ((rows (markdown-render-line renderer "```")))
      (test-assert (plusp (length rows)) "closed mermaid renders rows")
      (test-assert (search "A" (mermaid-test-text rows)) "render contains node")
      (test-assert (every (lambda (row) (<= (spans-width row) 50)) rows) "render respects width")
      (test-assert (find :code-copy (first (last rows)) :key #'span-role) "render has copy footer"))
    (test-assert (string= (markdown-renderer-closed-code-source renderer)
                          (format nil "flowchart LR~%  A-->B")) "closed source is exact body")
    (test-assert (plusp (length (markdown-render-line renderer "```"))) "ordinary fence follows Mermaid"))
  (let ((renderer (markdown-renderer-create :width 40)))
    (markdown-render-line renderer "```mermaid")
    (markdown-render-line renderer "not a diagram")
    (let ((rows (markdown-render-line renderer "```")))
      (test-assert (search "not a diagram" (mermaid-test-text rows)) "invalid mermaid falls back")
      (test-assert (search "1 │" (mermaid-test-text rows)) "fallback is numbered source")
      (test-assert (search "```mermaid" (mermaid-test-text rows)) "fallback includes the opening fence")
      (test-assert (some (lambda (row) (find :code-copy row :key #'span-role)) rows)
                   "a closed fallback offers source copying")
      (test-assert (string= "not a diagram" (markdown-renderer-closed-code-source renderer))
                   "fallback retains exact source")))
  (let ((renderer (markdown-renderer-create :width 40)))
    (markdown-render-line renderer "```mermaid")
    (markdown-render-line renderer "flowchart LR")
    (multiple-value-bind (committed preview retained)
        (markdown-render-partial renderer "")
      (declare (ignore retained))
      (test-assert (null committed) "empty partial commits nothing")
      (test-assert (search "flowchart LR" (mermaid-test-text preview)) "empty partial retains body"))
    (test-assert (null (markdown-renderer-closed-code-source renderer)) "partial does not mutate source")
    (multiple-value-bind (a pa ra) (markdown-render-partial renderer "x")
      (declare (ignore a ra))
      (multiple-value-bind (b pb rb) (markdown-render-partial renderer "x")
        (declare (ignore b rb))
        (test-assert (equal pa pb) "repeated partial is stable")))
    (let ((rows (termdown:markdown-render-finish renderer)))
      (test-assert (search "flowchart LR" (mermaid-test-text rows)) "finish flushes source")
      (test-assert (null (termdown:markdown-render-finish renderer)) "finish is idempotent")))
  (let ((renderer (markdown-renderer-create :width 40)))
    (markdown-render-line renderer "```")
    (let ((rows (markdown-render-line renderer "plain code")))
      (test-assert (search "plain code" (mermaid-test-text rows)) "normal code unaffected"))
    (markdown-render-line renderer "```")
    (test-assert (not (termdown::markdown-renderer-code-open-p renderer)) "normal code closes"))
  (let* ((renderer (markdown-renderer-create :width 80))
         (first-line (make-string 65500 :initial-element #\a))
         (last-line (make-string 100 :initial-element #\b)))
    (markdown-render-line renderer "```mermaid")
    (test-assert (null (markdown-render-line renderer first-line)) "buffer accepts a body below its cap")
    (test-assert (markdown-render-line renderer last-line) "overflow commits raw fallback immediately")
    (test-assert (and (not (termdown::markdown-renderer-mermaid-buffer-p renderer))
                      (null (termdown::markdown-renderer-mermaid-source renderer))
                      (zerop (termdown::markdown-renderer-mermaid-source-length renderer)))
                 "overflow releases diagram-only state")
    (markdown-render-line renderer "```")
    (test-assert (string= (format nil "~a~%~a" first-line last-line)
                          (markdown-renderer-closed-code-source renderer))
                 "overflow preserves body order for copying")
    (test-assert (search "after" (mermaid-test-text (markdown-render-line renderer "after")))
                 "ordinary Markdown follows an overflowed fence"))
  (let ((renderer (markdown-renderer-create :width 40)))
    (test-assert (markdown-render-line renderer
                                     (concatenate 'string "```mermaid"
                                                  (make-string 65536 :initial-element #\Space)))
                 "an oversized opening line is displayed without buffering")
    (test-assert (not (termdown::markdown-renderer-mermaid-buffer-p renderer))
                 "an oversized opener does not enter diagram buffering"))
  nil)
