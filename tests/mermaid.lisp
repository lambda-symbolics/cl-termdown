(in-package #:termdown/tests)

(defun mermaid-test-text (rows)
  "Flatten rendered rows for semantic content assertions."
  (with-output-to-string (stream)
    (dolist (row rows) (write-string (markdown-tests--row-text row) stream))))

(defun mermaid-test-notices (rows)
  "Return diagnostic rows without source rows or copy controls."
  (remove-if-not (lambda (row) (find :notice row :key #'span-role)) rows))

(defun mermaid-test-without-spaces (text)
  "Remove wrapping whitespace for condition-report comparisons."
  (remove-if (lambda (char) (find char '(#\Space #\Tab #\Newline #\Return))) text))

(defun test-mermaid-failure (body width condition-type)
  "Check a closed fallback against Clermaid's actual typed failure report."
  (let* ((renderer (markdown-renderer-create :width width))
         (condition (handler-case
                        (clermaid:render-mermaid-spans body :width (- width 2))
                      (clermaid:mermaid-error (condition) condition))))
    (test-assert (typep condition condition-type) "fixture signals the expected failure category")
    (markdown-render-line renderer "```mermaid")
    (dolist (line (uiop:split-string body :separator '(#\Newline)))
      (test-assert (null (markdown-render-line renderer line)) "failed diagram buffers source"))
    (let* ((rows (markdown-render-line renderer "```"))
           (notices (mermaid-test-notices rows)))
      (test-assert notices "closed failure has a visible diagnostic")
      (test-assert (search (mermaid-test-without-spaces
                            (clinedi:sanitize-text (princ-to-string condition) :single-line-p t))
                           (mermaid-test-without-spaces (mermaid-test-text notices)))
                   "diagnostic includes the actual condition report")
      (test-assert (every (lambda (row) (<= (spans-width row) width)) notices)
                   "failure diagnostic fits terminal cells")
      (test-assert (equal (subseq rows 0 (length notices)) notices)
                   "diagnostic precedes source")
      (let ((raw-renderer (markdown-renderer-create :width width :raw-fence-p t)))
        (test-assert
         (equal (nthcdr (length notices) rows)
                (loop for line in (append (list "```mermaid")
                                          (uiop:split-string body :separator '(#\Newline))
                                          (list "```"))
                      append (markdown-render-line raw-renderer line)))
         "fallback preserves ordinary source row order and footer"))
      (test-assert (search "1 │" (mermaid-test-text rows)) "failure displays numbered source")
      (test-assert (find :code-copy (first (last rows)) :key #'span-role)
                   "failure ends with a source-copy footer")
      (test-assert (string= body (markdown-renderer-closed-code-source renderer))
                   "failure preserves exact closed source")
      (markdown-render-line renderer "```text")
      (test-assert (null (markdown-renderer-closed-code-source renderer)) "next fence resets copy source")
      (test-assert (null (mermaid-test-notices (markdown-render-line renderer "ordinary")))
                   "following ordinary fence has no diagnostic")
      (markdown-render-line renderer "```"))))

(defun test-markdown-mermaid ()
  (let ((renderer (markdown-renderer-create :width 50)))
    (test-assert (null (markdown-render-line renderer "```mermaid")) "mermaid opener is buffered")
    (test-assert (null (markdown-render-line renderer "flowchart LR")) "mermaid body is buffered")
    (test-assert (null (markdown-render-line renderer "  A-->B")) "mermaid second body is buffered")
    (let ((rows (markdown-render-line renderer "```")))
      (test-assert (plusp (length rows)) "closed mermaid renders rows")
      (test-assert (null (mermaid-test-notices rows)) "supported graph has no failure diagnostic")
      (test-assert (search "A" (mermaid-test-text rows)) "render contains node")
      (test-assert (every (lambda (row) (<= (spans-width row) 50)) rows) "render respects width")
      (test-assert (find :code-copy (first (last rows)) :key #'span-role) "render has copy footer"))
    (test-assert (string= (markdown-renderer-closed-code-source renderer)
                          (format nil "flowchart LR~%  A-->B")) "closed source is exact body")
    (test-assert (plusp (length (markdown-render-line renderer "```"))) "ordinary fence follows Mermaid"))
  (let ((renderer (markdown-renderer-create :width 40)))
    (markdown-render-line renderer "```mermaid")
    (markdown-render-line renderer "not a diagram")
    (let ((rows (markdown-render-line renderer "```")))
      (test-assert (search "not a diagram" (mermaid-test-text rows)) "invalid mermaid falls back")
      (test-assert (search "1 │" (mermaid-test-text rows)) "fallback is numbered source")
      (test-assert (search "```mermaid" (mermaid-test-text rows)) "fallback includes the opening fence")
      (test-assert (some (lambda (row) (find :code-copy row :key #'span-role)) rows)
                   "a closed fallback offers source copying")
      (test-assert (string= "not a diagram" (markdown-renderer-closed-code-source renderer))
                   "fallback retains exact source")))
  (let ((renderer (markdown-renderer-create :width 40)))
    (markdown-render-line renderer "```mermaid")
    (markdown-render-line renderer "flowchart LR")
    (multiple-value-bind (committed preview retained)
        (markdown-render-partial renderer "")
      (declare (ignore retained))
      (test-assert (null committed) "empty partial commits nothing")
      (test-assert (search "flowchart LR" (mermaid-test-text preview)) "empty partial retains body")
      (test-assert (null (mermaid-test-notices preview)) "speculative source has no failure diagnostic"))
    (test-assert (null (markdown-renderer-closed-code-source renderer)) "partial does not mutate source")
    (multiple-value-bind (a pa ra) (markdown-render-partial renderer "x")
      (declare (ignore a ra))
      (multiple-value-bind (b pb rb) (markdown-render-partial renderer "x")
        (declare (ignore b rb))
        (test-assert (equal pa pb) "repeated partial is stable")))
    (let ((rows (termdown:markdown-render-finish renderer)))
      (test-assert (search "flowchart LR" (mermaid-test-text rows)) "finish flushes source")
      (test-assert (null (mermaid-test-notices rows)) "unfinished source has no failure diagnostic")
      (test-assert (null (termdown:markdown-render-finish renderer)) "finish is idempotent")))
  (let ((renderer (markdown-renderer-create :width 40)))
    (markdown-render-line renderer "```")
    (let ((rows (markdown-render-line renderer "plain code")))
      (test-assert (search "plain code" (mermaid-test-text rows)) "normal code unaffected"))
    (markdown-render-line renderer "```")
    (test-assert (not (termdown::markdown-renderer-code-open-p renderer)) "normal code closes"))
  (let* ((renderer (markdown-renderer-create :width 80))
         (first-line (make-string 65500 :initial-element #\a))
         (last-line (make-string 100 :initial-element #\b)))
    (markdown-render-line renderer "```mermaid")
    (test-assert (null (markdown-render-line renderer first-line)) "buffer accepts a body below its cap")
    (let* ((rows (markdown-render-line renderer last-line))
           (notices (mermaid-test-notices rows)))
      (test-assert notices "overflow has a visible diagnostic")
      (test-assert (every (lambda (row) (<= (spans-width row) 80)) notices)
                   "overflow diagnostic fits terminal cells"))
    (test-assert (and (not (termdown::markdown-renderer-mermaid-buffer-p renderer))
                      (null (termdown::markdown-renderer-mermaid-source renderer))
                      (zerop (termdown::markdown-renderer-mermaid-source-length renderer)))
                 "overflow releases diagram-only state")
    (test-assert (find :code-copy (first (last (markdown-render-line renderer "```"))) :key #'span-role)
                 "overflow closes with a source-copy footer")
    (test-assert (string= (format nil "~a~%~a" first-line last-line)
                          (markdown-renderer-closed-code-source renderer))
                 "overflow preserves body order for copying")
    (test-assert (search "after" (mermaid-test-text (markdown-render-line renderer "after")))
                 "ordinary Markdown follows an overflowed fence"))
  (let* ((renderer (markdown-renderer-create :width 40))
         (opener (concatenate 'string "```mermaid" (make-string 65536 :initial-element #\Space))))
    (multiple-value-bind (committed preview retained) (markdown-render-partial renderer opener)
      (declare (ignore committed retained))
      (test-assert (null (mermaid-test-notices preview)) "speculative oversized opener has no failure notice"))
    (test-assert (mermaid-test-notices (markdown-render-line renderer opener))
                 "oversized opening line has a visible diagnostic")
    (test-assert (not (termdown::markdown-renderer-mermaid-buffer-p renderer))
                 "an oversized opener does not enter diagram buffering"))
  (test-mermaid-failure (format nil "flowchart TD~%subgraph Group~%A-->B~%end")
                        40 'clermaid:unsupported-syntax)
  (test-mermaid-failure (format nil "flowchart TD~%A[") 40 'clermaid:invalid-diagram)
  (test-mermaid-failure (format nil "flowchart LR~%A[abcdefghijklmnopqrstuvwxyz]-->B")
                        24 'clermaid:diagram-too-wide)
  (let* ((renderer (markdown-renderer-create :width 24))
         (reason (format nil "bad~C[31m~C~C~A" #\Escape #\Return #\Tab
                         (make-string 40 :initial-element #\界)))
         (condition (make-condition 'clermaid:invalid-diagram :reason reason))
         (rows (termdown::markdown--mermaid-error-notice renderer condition)))
    (test-assert (> (length rows) 2) "long diagnostic wraps")
    (test-assert (every (lambda (row) (<= (spans-width row) 24)) rows)
                 "wide Unicode diagnostic fits terminal cells")
    (test-assert (notany (lambda (char) (or (< (char-code char) 32)
                                           (<= 127 (char-code char) 159)))
                         (mermaid-test-text rows))
                 "diagnostic spans contain no terminal controls"))
  nil)
