(in-package #:termdown/tests)

(-> test-display-math () null)
(defun test-display-math ()
  "Exercise closed display blocks and speculative rendering of a streamed matrix."
  (let* ((r (markdown-renderer-create :width 80))
         (matrix "A=\\begin{bmatrix}a&b\\\\10&c\\end{bmatrix}")
         (source (concatenate 'string "\\[" matrix "\\]"))
         (expected '("A=⎡a   b⎤" "  ⎣10  c⎦")))
    (flet ((texts (rows) (mapcar #'markdown-tests--row-text rows)))
      (test-assert (equal (texts (markdown-render-line r "\\[\\rho(x)\\]")) '("ρ(x)"))
                   "single-line display symbols")
      (test-assert (equal (texts (markdown-render-line r source)) expected) "one-line matrix")
      (test-assert (equal (texts (markdown-render-line r "\\[\\begin{bmatrix}界&x\\\\a&y\\end{bmatrix}\\]"))
                          (list "⎡界  x⎤" "⎣a   y⎦"))
                   "measure wide cells in terminal columns")
      (dolist (line '("\\[" "A=\\begin{bmatrix}a&b\\\\" "10&c\\end{bmatrix}"))
        (loop for n from 1 to (length line) for partial = (subseq line 0 n)
              do (multiple-value-bind (committed preview retained) (markdown-render-partial r partial)
                   (test-assert (and (null committed) preview (string= retained partial))
                                "partial matrix source is speculative")))
        (test-assert (null (markdown-render-line r line)) "buffer open display math"))
      (test-assert (equal (texts (nth-value 1 (markdown-render-partial r "\\]"))) expected)
                   "preview a complete matrix without committing it")
      (test-assert (equal (texts (markdown-render-line r "\\]")) expected) "commit matrix exactly once")
      (test-assert (null (termdown:markdown-render-finish r)) "nothing left after close")
      (dolist (bad '("\\[\\unknown{x}\\]" "\\[\\begin{bmatrix}a&b\\\\c\\end{bmatrix}\\]"))
        (test-assert (equal (texts (markdown-render-line r bad)) (list bad)) "show unsupported source"))
      (markdown-render-line r "\\[")
      (markdown-render-line r "**raw")
      (test-assert (equal (texts (termdown:markdown-render-finish r)) '("\\[" "**raw"))
                   "flush incomplete source literally")
      (test-assert (null (termdown:markdown-render-finish r)) "idempotent finish")
      (let* ((narrow (markdown-renderer-create :width 24))
             (wide "\\[\\begin{bmatrix}abcdefghijklm&nopqrstuvwxyz\\end{bmatrix}\\]")
             (rows (markdown-render-line narrow wide)))
        (test-assert (and (every (lambda (row) (<= (spans-width row) 24)) rows)
                          (string= wide (format nil "~{~A~}" (texts rows))))
                     "too-wide matrices show wrapped source"))))
  nil)
