(in-package #:termdown)

(defparameter *math-symbols*
  '(("alpha" . #\α) ("beta" . #\β) ("gamma" . #\γ) ("delta" . #\δ)
    ("epsilon" . #\ε) ("zeta" . #\ζ) ("eta" . #\η) ("theta" . #\θ)
    ("iota" . #\ι) ("kappa" . #\κ) ("lambda" . #\λ) ("mu" . #\μ)
    ("nu" . #\ν) ("xi" . #\ξ) ("pi" . #\π) ("rho" . #\ρ) ("sigma" . #\σ)
    ("tau" . #\τ) ("upsilon" . #\υ) ("phi" . #\φ) ("chi" . #\χ)
    ("psi" . #\ψ) ("omega" . #\ω) ("Gamma" . #\Γ) ("Delta" . #\Δ)
    ("Theta" . #\Θ) ("Lambda" . #\Λ) ("Xi" . #\Ξ) ("Pi" . #\Π)
    ("Sigma" . #\Σ) ("Upsilon" . #\Υ) ("Phi" . #\Φ) ("Psi" . #\Ψ)
    ("Omega" . #\Ω) ("times" . #\×) ("cdot" . #\·) ("pm" . #\±)
    ("le" . #\≤) ("leq" . #\≤) ("ge" . #\≥) ("geq" . #\≥)
    ("ne" . #\≠) ("neq" . #\≠) ("approx" . #\≈) ("infty" . #\∞)
    ("to" . #\→) ("rightarrow" . #\→) ("in" . #\∈) ("circ" . #\∘))
  "Supported LaTeX control words and their Unicode characters.")

(defun math-script-text (marker value)
  "Use Unicode only if every character has a matching script glyph."
  (let* ((sub (char= marker #\_))
         (from (if sub "0123456789+-=()aeijklmnoprstuvx" "0123456789+-=()in"))
         (to (if sub "₀₁₂₃₄₅₆₇₈₉₊₋₌₍₎ₐₑᵢⱼₖₗₘₙₒₚᵣₛₜᵤᵥₓ" "⁰¹²³⁴⁵⁶⁷⁸⁹⁺⁻⁼⁽⁾ⁱⁿ")))
    (if (every (lambda (c) (find c from)) value)
        (map 'string (lambda (c) (char to (position c from))) value)
        (format nil "~C(~A)" marker value))))

(-> math-symbol-text (string) (option string))
(defun math-symbol-text (text)
  "Render a bounded, single-line expression. Return NIL on unsupported input."
  (let ((i 0) (end (length text)))
    (when (> end 65536) (return-from math-symbol-text nil))
    (labels ((peek () (and (< i end) (char text i)))
             (fail () (return-from math-symbol-text nil))
             (group-text (depth)
               (unless (eql (peek) #\{) (fail))
               (incf i)
               (let ((start i) (result (expression depth)))
                 (unless (and (> i start) (eql (peek) #\})) (fail))
                 (incf i)
                 result))
             (atom-text (depth)
               (let ((c (peek)))
                 (unless c (fail))
                 (incf i)
                 (cond ((char= c #\\)
                        (let* ((start i)
                               (stop (or (position-if-not #'alpha-char-p text :start i) end))
                               (name (subseq text start stop)))
                          (setf i stop)
                          (cond ((string= name "frac")
                                 (let* ((n (group-text (1+ depth))) (d (group-text (1+ depth))))
                                   (format nil "((~A)/(~A))" n d)))
                                ((string= name "sqrt") (format nil "√(~A)" (group-text (1+ depth))))
                                (t (let ((pair (assoc name *math-symbols* :test #'string=)))
                                     (if pair (string (cdr pair)) (fail)))))))
                       ((or (not (graphic-char-p c)) (find c "{}_^$%&#~")) (fail))
                       (t (string c)))))
             (expression (depth)
               (when (> depth 32) (fail))
               (with-output-to-string (out)
                 (loop while (and (peek) (char/= (peek) #\}))
                       do (let ((base (atom-text depth)) (seen nil))
                            (write-string base out)
                            (loop while (and (peek) (find (peek) "_^"))
                                  for marker = (peek)
                                  do (when (or (member marker seen) (string= base " ")) (fail))
                                     (push marker seen)
                                     (incf i)
                                     (let ((value (if (eql (peek) #\{) (group-text (1+ depth))
                                                      (atom-text depth))))
                                       (write-string (math-script-text marker value) out))))))))
      (let ((result (expression 0)))
        (and (= i end) result)))))
